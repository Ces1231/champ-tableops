<mujoco model="champ_tableops_milestone2">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="8" armature="0.02"/>
    <geom friction="0.9 0.05 0.01"/>
  </default>

  <worldbody>
    <light pos="0 -0.5 2.5" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <camera name="demo" pos="0 -2.0 1.15" xyaxes="1 0 0 0 0.48 0.88"/>

    <geom
      name="floor"
      type="plane"
      pos="0 0 -0.01"
      size="2 2 0.1"
      rgba="0.10 0.12 0.16 1"/>

    <geom
      name="table"
      type="box"
      pos="0 0 0"
      size="0.75 0.55 0.05"
      rgba="0.34 0.20 0.10 1"/>

    <site
      name="target"
      type="cylinder"
      pos="0.35 0 0.052"
      size="0.13 0.002"
      rgba="0.1 1 0.25 0.45"/>

    <body name="plate" pos="-0.35 0 0.075">
      <freejoint/>
      <geom
        name="plate_geom"
        type="cylinder"
        size="0.11 0.025"
        mass="0.25"
        rgba="0.92 0.94 1 1"/>
      <site
        name="plate_grasp_site"
        pos="0 0 0.025"
        size="0.012"
        rgba="0 0.7 1 0.7"/>
    </body>

    <!-- Static support makes the Cartesian manipulator visually read as a robot. -->
    <geom
      name="robot_pedestal"
      type="box"
      pos="-0.67 0 0.32"
      size="0.07 0.09 0.32"
      rgba="0.12 0.30 0.82 1"
      contype="0"
      conaffinity="0"/>
    <geom
      name="robot_beam"
      type="box"
      pos="-0.05 0 0.70"
      size="0.68 0.055 0.045"
      rgba="0.16 0.38 0.95 1"
      contype="0"
      conaffinity="0"/>

    <!--
      Three actuated slide joints provide deterministic Cartesian motion.
      This keeps the hackathon demo reliable while still making the plate move
      because of a simulated manipulator rather than by rewriting plate qpos.
    -->
    <body name="robot_x" pos="-0.60 0 0.70" gravcomp="1">
      <joint name="slide_x" type="slide" axis="1 0 0" range="0 1.15"/>
      <geom
        type="box"
        size="0.05 0.07 0.05"
        rgba="0.05 0.75 1 1"
        contype="0"
        conaffinity="0"/>

      <body name="robot_y" gravcomp="1">
        <joint name="slide_y" type="slide" axis="0 1 0" range="-0.35 0.35"/>
        <geom
          type="box"
          size="0.045 0.055 0.045"
          rgba="0.05 0.65 0.9 1"
          contype="0"
          conaffinity="0"/>

        <body name="gripper" gravcomp="1">
          <joint name="slide_z" type="slide" axis="0 0 1" range="-0.52 0"/>
          <geom
            type="capsule"
            fromto="0 0 0 0 0 -0.10"
            size="0.028"
            rgba="0.12 0.82 0.95 1"
            contype="0"
            conaffinity="0"/>
          <geom
            type="box"
            pos="0 0 -0.11"
            size="0.07 0.13 0.018"
            rgba="0.08 0.16 0.24 1"
            contype="0"
            conaffinity="0"/>

          <body name="left_finger" pos="0 -0.14 -0.15" gravcomp="1">
            <joint name="left_finger_joint" type="slide" axis="0 1 0" range="0 0.05" damping="3"/>
            <geom
              type="box"
              size="0.014 0.014 0.055"
              rgba="0.95 0.55 0.08 1"
              contype="0"
              conaffinity="0"/>
          </body>

          <body name="right_finger" pos="0 0.14 -0.15" gravcomp="1">
            <joint name="right_finger_joint" type="slide" axis="0 -1 0" range="0 0.05" damping="3"/>
            <geom
              type="box"
              size="0.014 0.014 0.055"
              rgba="0.95 0.55 0.08 1"
              contype="0"
              conaffinity="0"/>
          </body>

          <site
            name="grasp_site"
            pos="0 0 -0.155"
            size="0.015"
            rgba="1 0.2 0.1 0.8"/>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- Runtime grasp latch. site-to-site weld is enabled only after approach. -->
    <weld
      name="grasp_weld"
      site1="grasp_site"
      site2="plate_grasp_site"
      active="false"
      solref="0.01 1"/>
  </equality>

  <actuator>
    <position name="x_position" joint="slide_x" kp="350" ctrlrange="0 1.15" ctrllimited="true"/>
    <position name="y_position" joint="slide_y" kp="350" ctrlrange="-0.35 0.35" ctrllimited="true"/>
    <position name="z_position" joint="slide_z" kp="900" ctrlrange="-0.52 0" ctrllimited="true"/>
    <position name="left_grip" joint="left_finger_joint" kp="120" ctrlrange="0 0.05" ctrllimited="true"/>
    <position name="right_grip" joint="right_finger_joint" kp="120" ctrlrange="0 0.05" ctrllimited="true"/>
  </actuator>
</mujoco>
